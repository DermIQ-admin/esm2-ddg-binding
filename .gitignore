# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environment ------------------------------------------------------------
.venv/
venv/
.env

# --- Data -------------------------------------------------------------------
# SKEMPI's raw CSV is not ours to redistribute, and it bloats the repo.
# src/data/download.py regenerates it. Keep the directory, drop the contents.
data/raw/*
!data/raw/.gitkeep

# data/processed/ is deliberately NOT ignored — the cleaned splits are committed
# so results are reproducible without re-downloading the raw data.

# --- Model artifacts --------------------------------------------------------
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# --- Experiment tracking ----------------------------------------------------
wandb/
.wandb/

# --- Results ----------------------------------------------------------------
# results/metrics.json IS committed — it is the numbers the README quotes.
# The per-run prediction CSVs are regenerable from the baselines and would
# otherwise churn ~2MB per experiment, so they are not.
results/preds_*.csv
# Training logs are transient; the curves that matter live in metrics.json
# under each run's "training" key.
train_*.log

# --- Caches -----------------------------------------------------------------
# Hugging Face model cache, if HF_HOME is ever pointed inside the repo.
.cache/
embeddings_cache/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Working notes, not part of the published project ------------------------
# Personal planning / assistant-context files. They stay on disk but are not
# part of the repo a reviewer reads.
PLAN.md
CLAUDE.md

# Training logs are transient; the curves that matter are in metrics.json
# under each run's "training" key.
logs/
