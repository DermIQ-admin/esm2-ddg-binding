# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environment ------------------------------------------------------------
.venv/
venv/
.env

# --- Data -------------------------------------------------------------------
# SKEMPI's raw CSV is not ours to redistribute, and it bloats the repo.
# src/data/download.py regenerates it. Keep the directory, drop the contents.
data/raw/*
!data/raw/.gitkeep

# data/processed/ is deliberately NOT ignored — the cleaned splits are committed
# so results are reproducible without re-downloading the raw data.

# --- Model artifacts --------------------------------------------------------
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# --- Experiment tracking ----------------------------------------------------
wandb/
.wandb/

# --- Results ----------------------------------------------------------------
# results/metrics.json IS committed — it is the numbers the README quotes.
# The per-run prediction CSVs are regenerable from the baselines and would
# otherwise churn ~2MB per experiment, so they are not.
results/preds_*.csv
# ...with two exceptions, 304KB total. The zero-shot context ablation (rho = 0.888
# between scoring a chain alone and inside its complex) is the finding that explains
# WHY the zero-shot floor is a floor, and notebook 02 cannot recompute it without
# these. Zero-shot never trains, so they are deterministic and will never churn.
!results/preds_zero_shot_esm2_t30_150M_UR50D.csv
!results/preds_zero_shot_esm2_t30_150M_UR50D_context-chain.csv
# Training logs are transient; the curves that matter live in metrics.json
# under each run's "training" key.
train_*.log

# --- Caches -----------------------------------------------------------------
# Hugging Face model cache, if HF_HOME is ever pointed inside the repo.
.cache/
embeddings_cache/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Working notes, not part of the published project ------------------------
# Personal planning / assistant-context files. They stay on disk but are not
# part of the repo a reviewer reads.
PLAN.md
CLAUDE.md

# Training logs are transient; the curves that matter are in metrics.json
# under each run's "training" key.
logs/

# Scratch results from convergence probes; the real runs live in results/
results_probe/

# --- DECISIONS.md working draft ---------------------------------------------
# DECISIONS.md's reasoning is Johannes's to write. DECISIONS.draft.md is a
# thinking aid to react to, in neutral third person so it cannot be shipped
# as-is. It must never be committed: an AI-drafted decisions log was already
# purged from this repo's history once, for exactly that reason.
DECISIONS.draft.md
